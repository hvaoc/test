{
  "name": "things3-clone",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web --output-dir dist-web",
    "desktop": "bash desktop/build.sh darwin/arm64",
    "desktop:intel": "bash desktop/build.sh darwin/amd64",
    "desktop:universal": "bash desktop/build.sh darwin/universal",
    "desktop:run": "open 'desktop/build/bin/things3-clone.app'",
    "sim:ios": "bash scripts/run-ios.sh",
    "emu:android": "bash scripts/run-android.sh",
    "e2e:ios": "bash scripts/e2e-ios.sh",
    "e2e:android": "bash scripts/e2e-android.sh",
    "e2e:web": "bash scripts/e2e-web.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "unicode-emoji-json": "^0.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/metro-config": "^0.81.5",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "private": true
}
